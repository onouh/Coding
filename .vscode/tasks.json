{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "detail": "Compile and Run FOS in debug mode",
            "type": "shell",
            "command": "make -bmik qemu-gdb",
            "options": {
                "cwd": "${workspaceFolder}/FOS"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            }
        },
        {
            "label": "clean",
            "detail": "Clean build files",
            "type": "shell",
            "command": "make -bmik clean",
            "problemMatcher": []
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Compilers_JASON/JASON_Compiler_Template/JASON_Compiler.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Compilers_JASON/JASON_Compiler_Template/JASON_Compiler.sln"
            ],
            "problemMatcher": "$msCompile"
        },
