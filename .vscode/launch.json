{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "gdb",
      "request": "attach",
      "name": "Run FOS",
      "executable": "obj/kern/kernel",
      "target": ":26000",
      "remote": true,
      "cwd": "${workspaceRoot}/FOS",
      "gdbpath": "/opt/cross/bin/i386-elf-gdb",  // <--- Add this line
      "preLaunchTask": "build-debug"
    
    },
