      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "SQL Database",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/DataBase_SQL/bin/Debug/net10.0/NorthWind.dll",
      "args": [],
      "cwd": "${workspaceFolder}/DataBase_SQL",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
